name = "bgstudio-ai-assistant"
main = "bg-assistant-worker.js"
compatibility_date = "2026-09-28"

[vars]
ALLOWED_ORIGINS = "https://3d.bgstudio.com.tr"
OPENAI_MODEL = "gpt-5.6-luna"

[[routes]]
pattern = "3d.bgstudio.com.tr/api/bg-assistant*"
zone_name = "bgstudio.com.tr"

# Per-IP rate limit used by the worker (8 requests / 60 s).
# namespace_id is any unique integer string within this Cloudflare account.
[[ratelimits]]
name = "RATE_LIMITER"
namespace_id = "1001"
simple = { limit = 8, period = 60 }
